{
  "name": "dajare",
  "description": "日本語のダジャレ（駄洒落）を生成するスキル。単語やお題・状況を入力すると、質の高いダジャレを3〜5個つくって返します。",
  "version": "1.5.1",
  "author": {
    "name": "coji"
  },
  "repository": "https://github.com/coji/dajare",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/refresh-spinner-if-stale.sh"
          }
        ]
      }
    ]
  }
}
