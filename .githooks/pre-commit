#!/bin/bash
# Sync root files to skills/dajare/ and skills/japanese-rap/
# Root SKILL.md, scripts/rhyme.py, and references/ are the single source of truth for dajare.
# japanese-rap/ is the single source of truth for the japanese-rap skill.
set -euo pipefail

# --- dajare ---
cp SKILL.md skills/dajare/SKILL.md
git add skills/dajare/SKILL.md

mkdir -p skills/dajare/scripts
cp scripts/rhyme.py skills/dajare/scripts/rhyme.py
git add skills/dajare/scripts/rhyme.py

if [ -f scripts/rhyme-dict.json.gz ]; then
  cp scripts/rhyme-dict.json.gz skills/dajare/scripts/rhyme-dict.json.gz
  git add skills/dajare/scripts/rhyme-dict.json.gz
fi

mkdir -p skills/dajare/references
rm -f skills/dajare/references/*.md
for f in references/*.md; do
  if [ -f "$f" ]; then
    cp "$f" "skills/dajare/$f"
    git add "skills/dajare/$f"
  fi
done

# Copy src dir into a temp sibling, then swap atomically so an interrupted
# copy never leaves the destination missing or half-populated.
sync_skill_dir() {
  local src="$1" dest="$2" tmp="$2.tmp.$$"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  cp -r "$src"/* "$tmp"/
  rm -rf "$dest"
  mv "$tmp" "$dest"
  git add "$dest/"
}

# --- japanese-rap ---
if [ -d japanese-rap ]; then
  sync_skill_dir japanese-rap skills/japanese-rap
fi

# --- dajare-spinner ---
if [ -d dajare-spinner ]; then
  sync_skill_dir dajare-spinner skills/dajare-spinner
fi
